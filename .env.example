# ─────────────────────────────────────────────────────────────────────────────
# MAITRI RESIDENCY — ENVIRONMENT TEMPLATE (variable names only, never secrets)
# Copy to `.env.local` and fill in real values. Nothing here is a live credential.
# ─────────────────────────────────────────────────────────────────────────────

# ── Launch mode ──────────────────────────────────────────────────────────────
# PREVIEW  → safe concept mode. No orders transmitted, no messages sent, no charges.
# WHATSAPP → call/WhatsApp-assisted ordering to the number below.
# ONLINE   → persistent orders stored via Supabase (Mode B).
NEXT_PUBLIC_ORDER_MODE=preview
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Business configuration (confirm every value with Maitri before launch) ───
# Publicly posted food-delivery number for Hotel Maitri.
NEXT_PUBLIC_DELIVERY_PHONE=+918985051111
NEXT_PUBLIC_DELIVERY_PHONE_DISPLAY=+91 89850 51111

# ── Optional: Supabase (required only for NEXT_PUBLIC_ORDER_MODE=online + admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: staff notifications for new orders (Mode B) ────────────────────
# Example: an approved WhatsApp Cloud API or transactional e-mail provider.
ORDER_NOTIFICATION_CHANNEL=
ORDER_NOTIFICATION_WEBHOOK_URL=
ORDER_NOTIFICATION_WEBHOOK_SECRET=

# ── Optional: payments. Do NOT enable until Maitri authorises credentials. ───
# Razorpay keys must live server-side only and stay unset in concept preview.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
